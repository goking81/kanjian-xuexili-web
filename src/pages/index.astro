---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReportPreview from "../components/ReportPreview.astro";
import { siteConfig } from "../config";
import "../styles/home.css";

const title = "看见学习力｜青少年学习力测评，看见孩子的学习方式与亲子差异";
const description = "家长先观察，孩子再表达。通过家长20题、孩子40题的轻量测评，看见学习方式与亲子观察差异，找到家庭可以尝试的支持。";
const dimensions = [
  { name: "驱动力", child: 82, parent: 66 },
  { name: "行动力", child: 61, parent: 48 },
  { name: "理解力", child: 76, parent: 70 },
  { name: "抗挫力", child: 54, parent: 62 },
  { name: "环境力", child: 68, parent: 80 },
  { name: "潜能力", child: 90, parent: 74 },
];
const situations = [
  { label: "学习习惯", title: "孩子写作业总是拖延怎么办？", text: "先分清是不会做、难开始，还是任务太大不知道从哪里下手。", href: "/guides/homework-procrastination/" },
  { label: "学习动力", title: "孩子学习动力不足，只能靠催吗？", text: "兴趣、目标感、成功体验和外部压力，可能正在产生不同影响。", href: "/guides/learning-motivation/" },
  { label: "亲子沟通", title: "家长眼里的孩子，为什么和孩子自己不一样？", text: "同一个行为，家长看到的是磨蹭，孩子感受到的可能是无从开始。", href: "/guides/parent-child-gap/" },
  { label: "学习方法", title: "学习力的六个维度分别在看什么？", text: "环境、任务结构和恢复方式，也会影响孩子如何学习。", href: "/how-it-works/" },
];
const benefits = [
  { title: "学习优势画像", text: "知道孩子在哪类任务里更容易主动、理解和进入状态。" },
  { title: "行动卡点解释", text: "区分“不会做”“不愿做”和“不知道怎么开始”，减少无效催促。" },
  { title: "亲子观察差异", text: "看到家长观察与孩子自我感受之间不一致的地方。" },
  { title: "下一步支持建议", text: "把结论落到家庭可以尝试的小动作，不停留在抽象标签里。" },
];
const overviewBenefits = [
  { title: "看见学习方式", text: "了解孩子的学习特点，看看哪些任务容易投入、哪些环节容易卡住。" },
  { title: "对照亲子观察", text: "把孩子的自评与家长的观察放在一起，理解彼此的视角。" },
  { title: "找到一个小行动", text: "结合报告提示，选一个具体、今天就能尝试的支持方法。" },
];
const steps = [
  { title: "家长先观察", icon: "M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3M9 3h6v4H9zM8 13l3 3 5-5", text: "用 20 道题，回顾孩子在日常学习中的表现。先填昵称和年级，无需真实姓名。" },
  { title: "孩子独立表达", icon: "M3 21l1-5L16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 2ZM14 6l4 4M4 16l3 3", text: "让孩子完成 40 道题，表达自己的感受。可以陪伴，但不要代替孩子选择。" },
  { title: "一起读懂报告", icon: "M3 21v-6h4v6m3 0V9h4v12m3 0V3h4v18H3", text: "先确认哪条描述像自己，再讨论一个具体例子。支持中途退出后继续。" },
];
const questions = [
  { name: "看见学习力适合谁？", text: "适合希望了解孩子学习方式、学习动力、任务卡点和亲子观察差异的家庭，尤其适合小学高年级至初中阶段，由家长和孩子共同完成。" },
  { name: "测评的目的是什么？", text: "为家庭提供更具体的学习观察与沟通起点。结果不用于能力排名，也不替代医学、心理或教育诊断；一次测评不能定义孩子。" },
  { name: "需要多长时间完成？有哪些题目？", text: "家长完成 20 题，孩子完成 40 题，涉及驱动力、行动力、理解力、抗挫力、环境力和潜能力。具体时间取决于阅读和思考速度，可以中途退出后继续。" },
  { name: "可以直接在网站上答题吗？", text: "测评和报告阅读在“看见学习力”微信小程序内完成。点击测评按钮可查看小程序码或复制名称，网站不会要求填写孩子信息，也不收款。完整报告的内容与费用可在报告说明页查看。" },
];
const schema = [
  { "@context": "https://schema.org", "@type": "WebSite", name: siteConfig.name, url: siteConfig.origin, description },
  { "@context": "https://schema.org", "@type": "SoftwareApplication", name: siteConfig.name, applicationCategory: "EducationalApplication",
    operatingSystem: "微信小程序", description, offers: [
      { "@type": "Offer", name: "测评与免费报告", price: "0", priceCurrency: "CNY" },
      { "@type": "Offer", name: "本次测评完整报告（单次购买）", price: siteConfig.fullReportPrice, priceCurrency: "CNY", url: "https://dna.learnbox.cc/report/#report-access" },
    ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: questions.map(({ name, text }) => ({
    "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text },
  })) },
];
---
<BaseLayout title={title} description={description} schema={schema} pageClass="home-landing" image="/images/family-hero.webp">
  <section class="landing-hero" aria-labelledby="hero-title">
    <picture class="landing-photo">
      <source media="(max-width: 620px)" srcset="/images/family-hero-960.webp" />
      <img src="/images/family-hero.webp" alt="家长和孩子一起查看报告、交流学习经历的场景示意" width="1536" height="1024" fetchpriority="high" />
    </picture>
    <div class="wrap landing-hero-inner">
      <div class="landing-hero-copy">
        <h1 id="hero-title">看见学习力</h1>
        <p class="landing-tagline">孩子怎么学，先一起看见。</p>
        <p class="landing-lead">家长先观察，孩子再表达。<br />看见学习方式与亲子差异，找到下一步支持。</p>
        <div class="landing-actions">
          <button class="button button-primary js-open-mini" type="button">去微信小程序测评</button>
          <a class="landing-text-link" href="#report-overview">先看报告样例 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
  <div class="landing-facts" aria-label="测评概览">
    <div class="wrap landing-facts-inner">
      <p>家长 <strong>20</strong> 题</p><p>孩子 <strong>40</strong> 题</p><p>六维学习观察</p><p>亲子视角对照</p>
    </div>
  </div>
  <section class="landing-section landing-overview" id="report-overview" aria-labelledby="overview-title">
    <div class="wrap">
      <h2 id="overview-title">不是一个分数，是一次更具体的理解</h2>
      <div class="landing-report-grid">
        <figure class="landing-sample">
          <figcaption><span class="sample-heading">报告样例</span><span class="sample-label">虚构示例</span></figcaption>
          <dl class="sample-chart">
            {dimensions.map(({ name, child, parent }) => (
              <div class="sample-chart-row">
                <dt>{name}</dt>
                <dd>
                  <span class="sample-bar-line"><span class="sample-track" aria-hidden="true"><span class="sample-bar child-bar" style={`width: ${child}%`}></span></span><span class="sample-value"><span class="visually-hidden">孩子自评 </span>{child}</span></span>
                  <span class="sample-bar-line"><span class="sample-track" aria-hidden="true"><span class="sample-bar parent-bar" style={`width: ${parent}%`}></span></span><span class="sample-value"><span class="visually-hidden">家长观察 </span>{parent}</span></span>
                </dd>
              </div>
            ))}
          </dl>
          <div class="sample-legend"><span><i class="child-key"></i>孩子自评</span><span><i class="parent-key"></i>家长观察</span></div>
          <p class="sample-note">示例分数仅用于展示阅读方式，不是能力百分比、同龄人排名或真实用户结果。</p>
        </figure>
        <div class="landing-benefits">
          <ol>{overviewBenefits.map(({ title, text }, index) => (
            <li><span class="landing-benefit-number" aria-hidden="true">{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>
          ))}</ol>
        </div>
      </div>
    </div>
  </section>
  <section class="landing-section landing-process" id="method" aria-labelledby="process-title">
    <div class="wrap">
      <h2 id="process-title" class="visually-hidden">测评流程</h2>
      <ol class="landing-steps">{steps.map(({ title, text, icon }, index) => (
        <li>
          <svg class="landing-step-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg>
          <h3><span class="landing-step-number" aria-hidden="true">0{index + 1}</span>{title}</h3>
          <p>{text}</p>
        </li>
      ))}</ol>
    </div>
  </section>
  <section class="landing-section landing-situations" id="situations" aria-labelledby="situations-title">
    <div class="wrap">
      <p class="landing-kicker">家长常见困惑</p>
      <h2 id="situations-title">这些看起来像“态度问题”的表现，背后可能是不同的学习卡点</h2>
      <p class="section-intro">从一个熟悉的场景开始，看看孩子可能卡在哪一步。</p>
      <div class="problem-grid">
        {situations.map(({ label, title, text, href }) => (
          <a class="problem-link" href={href}><span>{label}</span><h3>{title}</h3><p>{text}</p></a>
        ))}
      </div>
    </div>
  </section>
  <section class="landing-section landing-report" id="report" aria-labelledby="report-title">
    <div class="wrap">
      <p class="landing-kicker">报告样例</p>
      <h2 id="report-title">报告不是给孩子打分，而是把“他为什么这样学”说得更具体</h2>
      <div class="landing-report-grid">
        <ReportPreview />
        <div class="landing-benefits">
          <p class="landing-kicker">完成后，家长能得到</p>
          <ol>{benefits.map(({ title, text }, index) => (
            <li><span class="landing-benefit-number" aria-hidden="true">{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>
          ))}</ol>
          <a class="landing-text-link" href="/report/">了解报告内容与费用 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
  <section class="landing-section landing-faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="landing-section-head"><h2 id="faq-title">开始前，你可能想知道</h2><a class="landing-text-link" href="/faq/">更多问题 <span aria-hidden="true">→</span></a></div>
      <div class="landing-questions">{questions.map(({ name, text }) => <details><summary>{name}</summary><p>{text}</p></details>)}</div>
      <div class="landing-guide"><span>从一个熟悉的场景开始</span><a href="/guides/homework-procrastination/">作业拖延 <span aria-hidden="true">↗</span></a><a href="/guides/learning-motivation/">学习动力 <span aria-hidden="true">↗</span></a><a href="/guides/parent-child-gap/">亲子沟通 <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="landing-close" aria-labelledby="close-title">
    <div class="wrap">
      <h2 id="close-title">从一次不带评判的对话开始</h2>
      <p>不急着下结论，先听听孩子怎么说。</p>
      <button class="button button-primary js-open-mini" type="button">去微信小程序测评</button>
      <span class="landing-signature" aria-hidden="true">看见学习力</span>
    </div>
  </section>
</BaseLayout>
