---
const { title = "先看见，再开始改变", text = "用一份轻量学习力测评，和孩子聊一次更具体、更少评判的学习对话。" } = Astro.props;
---
<section class="final-cta">
  <div class="wrap final-inner"><div class="final-copy"><h2>{title}</h2><p>{text}</p></div><button class="button button-dark js-open-mini" type="button">打开微信小程序</button></div>
</section>
